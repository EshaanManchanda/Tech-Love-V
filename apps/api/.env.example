# Copy to .env and fill in real values. Never commit the real .env file.

# "production" enables secure cookies (HTTPS-only) and locks CORS to APP_URL
# instead of the localhost dev range. Leave unset (or "development") locally.
NODE_ENV=development

PORT=4000

# Local dev: the Docker container from docker-compose.yml (`docker compose up -d mongo`).
# Production: a MongoDB Atlas free-tier (M0) connection string instead —
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/certificate-license-platform?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/certificate-license-platform

# Any long random string — e.g. `openssl rand -hex 32`. Must differ between
# access/refresh, and must differ per environment (never reuse a dev secret in prod).
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Public URL of the web app (apps/web). Used for CORS allow-list, email links
# (set-password/invite), and Stripe checkout success/cancel redirect URLs.
APP_URL=http://localhost:3000

# Leave unset in dev (localhost cookies work fine host-only). Set in production
# ONLY if the API and web app live on different subdomains of the same parent
# domain (e.g. api on tlvapi.example.com, web on app.example.com) — set to
# ".example.com" (leading dot) so auth cookies are shared across both. Without
# this, cookies set by the API are host-only and the web app's middleware
# never sees them, breaking login (POST succeeds, but you bounce back to
# /login immediately after).
COOKIE_DOMAIN=

# Stripe — test-mode keys locally, live keys in production. The webhook secret
# comes from the Stripe CLI (`stripe listen`) locally, or the Dashboard's
# webhook endpoint config in production. Price IDs come from `npm run stripe:setup-prices`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_DT_PAID_MONTHLY=
STRIPE_PRICE_DT_PAID_YEARLY=

# BullMQ (email queue) — same Redis instance apps/worker connects to.
# Local dev: the Docker container (`docker compose up -d redis`).
# Production: a cloud Redis free tier instead (Upstash or Redis Cloud) — note `rediss://`
# (TLS), not `redis://` — e.g. rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379
