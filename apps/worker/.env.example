# Copy to .env and fill in real values. Never commit the real .env file.
# Must point at the SAME MongoDB and Redis instances as apps/api — this
# process reads the License/Activation/User collections the API writes to,
# and consumes the email queue the API enqueues jobs onto.

# Local dev: Docker containers (docker-compose.yml). Production: MongoDB Atlas free tier
# (mongodb+srv://...) and a cloud Redis free tier like Upstash/Redis Cloud (rediss://...)
# — see apps/api/.env.example for the exact format.
MONGODB_URI=mongodb://localhost:27017/certificate-license-platform
REDIS_URL=redis://localhost:6379

# Optional — if unset, emails are logged to the console instead of sent
# (dev-safe default; not safe to leave unset in production, since invite/
# renewal-reminder emails will silently never reach customers).
RESEND_API_KEY=
EMAIL_FROM=Certificate Generator <onboarding@resend.dev>
