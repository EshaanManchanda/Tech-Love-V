# Copy to .env.local (dev) or .env.local on the server (production build also
# reads .env.local — see Next.js env file loading order). Never commit the real file.

# Where the browser AND the Next.js server (admin/layout.tsx, downloads page)
# reach apps/api. In production this must be the real public API URL
# (e.g. https://api.yourdomain.com), reachable over HTTPS.
NEXT_PUBLIC_API_URL=http://localhost:4000
